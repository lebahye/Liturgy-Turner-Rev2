  "pageTexts": {
    "1": [
      "Օրհնեալ է Թագաւորութիւնն Հօր եւ Որդւոյ եւ Սուրբ Հոգւոյն, այժմ եւ միշտ եւ յաւիտեանս յաւիտենից:"
    ],
    "5": [
      "Եկեք երկիր պագցուք եւ անկցուք առ Քրիստոս:"
    ],
    "8": [
      "Սուրբ Աստուած, Սուրբ եւ Հզօր, Սուրբ եւ Անմահ, որ խաչեցար վասն մեր, ողորմեա մեզ:"
    ],
    "12": [
      "Ընթերցուածք յԱռաքելոց"
    ],
    "15": [
      "Ընթերցուածք ի Սուրբ Աւետարանէ"
    ],
    "20": [
      "Հաւատամք ի մի Աստուած"
    ],
    "25": [
      "Վեր ի վեր սիրտք ձեր"
    ],
    "30": [
      "Սուրբ, Սուրբ, Սուրբ է Տէր Սաբաւովթ"
    ],
    "35": [
      "Առեալ զհացս"
    ],
    "40": [
      "Եւ արասցէ զհացս զայս մարմին"
    ],
    "45": [
      "Հայր մեր որ յերկինս ես"
    ],
    "50": [
      "Զայս մարմին փրկութեան եւ զայս արիւն քաւութեան"
    ],
    "55": [
      "Մատիր անդ ի սուրբ եւ յերկնաւոր խորհուրդս քո"
    ],
    "60": [
      "Գոհութիւն առնեմք քեզ"
    ],
    "65": [
      "Օրհնութիւն եւ փառք"
    ]
  }
