// Project-local Clawdbot config (example)
//
// This is intentionally minimal; it boots an embedded agent that can be used
// for local automations (cron, evaluation jobs, etc.) without connecting to
// any messaging channels.
//
// IMPORTANT: copy to agent/clawdbot.json5 and customize as needed.

{
  // This is a **project-local** config. agent/run-gateway.sh sets:
  // - CLAWDBOT_STATE_DIR=./agent/.clawdbot-state
  // - CLAWDBOT_CONFIG_PATH=./agent/clawdbot.json5

  gateway: {
    mode: "local",
    // Use a non-default port so this project can run alongside any other Clawdbot instance.
    port: 29789,

    // Serve the browser Control UI under /clawdbot so it can be reverse-proxied
    // through the main app (port 5000) and embedded as a single site.
    controlUi: {
      basePath: "/clawdbot",
      // We're typically running on plain HTTP locally; allow token auth without
      // WebCrypto/device identity.
      allowInsecureAuth: true,
    },
  },

  agents: {
    defaults: {
      // Keep the agent's workspace constrained to this repo.
      workspace: "./",
      // Pick a provider that is likely to be available on a fresh install.
      // (You can override later in production deployments.)
      model: { primary: "openai-codex/gpt-5.2" },
    },
    list: [
      {
        id: "liturgy",
        default: true,
        workspace: "./",
        identity: {
          name: "Liturgy Agent",
          emoji: "📖",
        },
      },
    ],
  },

  // Skills
  // - Bundled skills come from your installed clawdbot package.
  // - Project-specific skills live in ./agent/skills (this repo).
  skills: {
    load: {
      extraDirs: ["./agent/skills"],
      watch: true,
      watchDebounceMs: 250,
    },
    entries: {
      "liturgy-controller": { enabled: true },
    },
  },

  // No channels by default (enable Telegram/WhatsApp later for remote control).
  channels: {},

  // Cron scheduler (optional; useful later for check-ins / automation).
  cron: { enabled: true },

  // Convenience: inject base URL for the Liturgy server.
  // You can also set this in your shell environment.
  env: {
    LITURGY_BASE_URL: "http://localhost:5000",
  },
}
