{
  enabled: true,

  // Create a bot with BotFather and paste the token here.
  // Prefer using env var TELEGRAM_BOT_TOKEN in production.
  botToken: "PASTE_TELEGRAM_BOT_TOKEN_HERE",

  // For safety: only allow specific users to control the system.
  // Use tg:<numeric_id> (recommended).
  // You can find your id via @userinfobot.
  dmPolicy: "allowlist",
  allowFrom: ["tg:123456789"],

  // Keep group handling locked down.
  groupPolicy: "disabled",
  groups: {},
}
