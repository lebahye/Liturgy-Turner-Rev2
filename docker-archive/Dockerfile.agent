FROM node:22-slim

RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    alsa-utils \
    libasound2-dev \
    sox \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/agent

COPY agent/package*.json ./

# Use npm install instead of npm ci so lock file mismatches don't fail
RUN npm install

# Copy agent runtime files
COPY agent/ ./

RUN chmod +x /app/agent/start-agent.sh

RUN mkdir -p /app/agent/.clawdbot-state /app/agent/memory /app/data /app/uploads /app/training-data

EXPOSE 29788

HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=30s \
  CMD node -e "fetch('http://127.0.0.1:29788/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["bash", "/app/agent/start-agent.sh"]
