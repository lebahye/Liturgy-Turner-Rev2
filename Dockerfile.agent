FROM node:22-slim

# Install system dependencies + openclaw + sqlite3 (for database access)
RUN apt-get update && apt-get install -y \
    bash git curl sqlite3 python3 make g++ \
    && npm install -g openclaw@latest \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/agent

# Copy agent configuration
COPY agent/ .

# Fix permissions on config file (might be root-owned)
RUN chmod 644 clawdbot.json5 || true

# Create state and data directories
RUN mkdir -p .clawdbot-state /app/data /app/uploads /app/training-data

# Install better-sqlite3 for database access
RUN npm init -y && npm install better-sqlite3

# Environment variables for agent
ENV CLAWDBOT_STATE_DIR=/app/agent/.clawdbot-state
ENV CLAWDBOT_CONFIG_PATH=/app/agent/clawdbot.json5

# Expose Clawdbot gateway port and audio API port
EXPOSE 29789 29788

# Make start script executable
RUN chmod +x /app/agent/start-agent.sh

# Health check (check if gateway is running)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:29789/status || exit 1

# Start both audio API and gateway
CMD ["/app/agent/start-agent.sh"]
