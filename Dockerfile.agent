FROM node:22-slim

RUN apt-get update && apt-get install -y \
    bash curl sqlite3 python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/agent

# Install deps first for better layer caching
COPY agent/package*.json ./
RUN npm ci

# Copy agent runtime files
COPY agent/ ./

# Ensure startup script is executable
RUN chmod +x /app/agent/start-agent.sh

# Runtime dirs
RUN mkdir -p /app/agent/.clawdbot-state /app/agent/memory /app/data /app/uploads /app/training-data

ENV NODE_ENV=production
ENV AUDIO_API_PORT=29788
ENV APP_BASE_URL=http://app:5000

EXPOSE 29788

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:29788/health || exit 1

CMD ["bash", "/app/agent/start-agent.sh"]
