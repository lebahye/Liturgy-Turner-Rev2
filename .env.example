# Local dev (WSL/Ubuntu)
#
# Database
# If DATABASE_URL is set to a Postgres URL, the app will use Postgres.
# Otherwise it will default to SQLite at SQLITE_DB_PATH.
#
# Example (SQLite default):
SQLITE_DB_PATH=./data/liturgy-turner.db
#
# Example (Postgres optional):
# DATABASE_URL=postgres://user:pass@localhost:5432/liturgy_turner

# Server
PORT=5000
HOST=0.0.0.0

# Public base URL (optional). Useful when running Cloudflare Tunnel or any HTTPS reverse proxy.
# PUBLIC_BASE_URL=https://your-domain.example

# AI providers (optional)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
